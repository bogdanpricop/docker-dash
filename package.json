{
  "name": "docker-dash",
  "version": "8.96.9",
  "description": "Full-featured Docker management dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --verbose --forceExit",
    "test:watch": "jest --watch",
    "build:novnc": "node scripts/sync-vendor.js --novnc",
    "lint": "eslint src/ public/js/ --max-warnings=0",
    "check:self-service-i18n": "node scripts/validate-self-service-i18n.js",
    "check:self-service-a11y": "node scripts/validate-self-service-a11y.js",
    "check:virtualization-research": "node scripts/validate-virtualization-feature-registry.js",
    "generate:virtualization-research": "node scripts/validate-virtualization-feature-registry.js --write",
    "lint:fix": "eslint src/ --fix",
    "version": "node scripts/sync-version.js && git add src/version.js docker-compose.yml",
    "check:page-help": "node scripts/check-page-help.js",
    "build:vendor": "node scripts/sync-vendor.js",
    "check:vendor": "node scripts/sync-vendor.js --check",
    "check:syntax": "node scripts/check-syntax.js",
    "audit:dependencies": "npm audit --audit-level=low",
    "check:browser": "node scripts/check-browser-libraries.js",
    "check:inventory-browser": "node scripts/check-inventory-views-browser.js"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ldapts": "^9.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "tar-stream": "3.2.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "canvas": "^3.2.3",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "gif-encoder-2": "^1.0.5",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "puppeteer": "^25.11.0",
    "sharp": "^0.35.4",
    "supertest": "^7.2.2"
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "overrides": {
    "ioredis-mock": {
      "ioredis": "^6.0.0"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "canvas@3.2.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.11.0": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3": false,
    "protobufjs": false
  },
  "packageManager": "npm@11.19.1"
}
