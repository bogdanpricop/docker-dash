# Docker Dash — Caddy HTTPS Reverse Proxy (Example)
# Usage: docker compose --profile tls up -d
#
# Replace YOUR_HOST with your actual IP or domain:
#   - LAN:    https://192.168.1.100
#   - Domain: https://dash.example.com
#
# For domains, remove the `tls internal` directive to get Let's Encrypt auto-certs.
{
	# Containers do not own the host trust store; clients import the CA explicitly.
	skip_install_trust
	# Browsers and curl may omit SNI when the configured host is an IP address.
	default_sni YOUR_HOST
}

https://YOUR_HOST {
	reverse_proxy docker-dash:{$APP_PORT:8101}

	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	encode gzip zstd
}
